.home-stars(aria-hidden="true")
  - for (let i = 0; i < 108; i++) {
    - const x = (Math.random() * 104 - 4).toFixed(2)
    - const y = (Math.random() * 112).toFixed(2)
    - const duration = 4.5 + Math.random() * 4.5
    - const delay = -Math.random() * duration
    i(style=`left:${x}%;top:${y}%;animation-duration:${duration.toFixed(2)}s;animation-delay:${delay.toFixed(2)}s`)
  - }
  span.home-meteor
