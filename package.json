{
  "name": "lichermione-blog",
  "version": "1.0.0",
  "description": "Lichermione 的 Hexo 技术博客",
  "private": true,
  "scripts": {
    "clean": "node tools/run-hexo.cjs clean",
    "build": "node tools/run-hexo.cjs clean && node tools/run-hexo.cjs generate",
    "check": "node tools/check-site.mjs && npm run check:order",
    "validate": "npm run build && npm run check",
    "dev": "node tools/run-hexo.cjs server",
    "draft": "node tools/run-hexo.cjs server --draft",
    "new": "node tools/run-hexo.cjs new",
    "publish": "node tools/run-hexo.cjs publish",
    "server": "node tools/run-hexo.cjs server",
    "setup": "node tools/setup.cjs",
    "check:order": "node tools/check-order.mjs",
    "prebuild": "node tools/check-env.cjs",
    "test:order": "node --test tools/post-order.test.cjs"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "engines": {
    "node": ">=20.19 <25"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "hexo": "8.1.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-wordcount": "^6.0.1"
  }
}
